	},
	"homepage": "https://github.com/printf83/ts-game#readme",
	"devDependencies": {
		"compression-webpack-plugin": "^12.0.0",
		"gh-pages": "^6.3.0",
		"terser-webpack-plugin": "^5.6.1",
		"ts-loader": "^9.6.2",
		"typescript": "^5.9.3",
		"webpack": "^5.109.2",
		"webpack-cli": "^5.1.4"
	},
	"overrides": {
		"fast-uri": "^3.1.5"
	}
